# Paths and addresses for running natively (no Docker). Loaded AFTER ../../.env by the systemd
# units and by deploy/linux/run, so these win over anything Docker-specific left in .env.
# Paths are relative to each service's folder: brain/ for the brain, bridge/ for the bridge.
# The data/ layout is the same one docker-compose used, so a copied data/ folder just works.

# brain (runs in brain/)
DATABASE_URL=sqlite:///../data/brain/brain.db
MEDIA_DIR=../data/brain/media
GOOGLE_DIR=../data/brain/google

# bridge (runs in bridge/)
AUTH_DIR=../data/bridge-auth
BRAIN_URL=http://127.0.0.1:8000
