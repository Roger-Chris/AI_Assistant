# ---------- Brain ----------
BRAIN_HOST=0.0.0.0
BRAIN_PORT=8000
# Shared secret between bridge/worker/app and the brain. Generate: openssl rand -hex 24
BRAIN_TOKEN=change-me
# Your name as people write it in chats — the classifier uses it to decide what's addressed to you
OWNER_NAME=Kishaunjith
# Nicknames / handles people use for you in chats (comma-separated) — used by the group filter
OWNER_ALIASES=
# Groups: only send a message to the model if it mentions you or has a task/time signal
GROUP_KEYWORD_GATE=true
DATABASE_URL=sqlite:///./data/brain.db
TZ=Asia/Kolkata

# ---------- LLM: cheap classifier (high volume) ----------
# Gemini free tier via its OpenAI-compatible endpoint:
CLASSIFIER_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
CLASSIFIER_API_KEY=
# Several keys, comma-separated, are rotated round-robin (and a rate-limited key is skipped
# for a minute). Takes precedence over CLASSIFIER_API_KEY.
CLASSIFIER_API_KEYS=
CLASSIFIER_MODEL=gemini-3.5-flash-lite
# Minimum classifier confidence before a task is surfaced for confirmation
CLASSIFIER_MIN_CONFIDENCE=0.6

# ---------- LLM: strong planner (low volume: brief, drafting) ----------
# Default: Gemini's top Flash model on the same free keys. Any OpenAI-compatible endpoint works,
# e.g. OpenRouter: PLANNER_BASE_URL=https://openrouter.ai/api/v1  PLANNER_MODEL=anthropic/claude-sonnet-4
PLANNER_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
PLANNER_API_KEY=
PLANNER_API_KEYS=
PLANNER_MODEL=gemini-3.8-flash

# ---------- Google (Calendar now; Gmail/Drive later) ----------
# Put the OAuth desktop-client JSON at data/brain/google/credentials.json, then run once:
#   docker compose run --rm -p 8765:8765 brain python -m app.google_auth
CALENDAR_NAME=Assistant
# Also put tasks with a due time on the calendar as 30-min "Due: ..." blocks (events always go)
CALENDAR_SYNC_TASKS_WITH_DUE=true
# Gmail: every authorised account is polled; promotions/social/forums never reach the brain
GMAIL_POLL_MINUTES=5
GMAIL_BACKFILL_DAYS=3

# ---------- Memory graph ----------
# People, orgs and projects learned from chats, mail and your CV. Injected into the classifier
# prompt so it knows who matters. Seed it once:
#   docker compose run --rm brain python -m app.seed_profile /data/profile/resume.docx
GRAPH_ENABLED=true
GRAPH_HOUR=3
GRAPH_DAILY_MESSAGES=300
GRAPH_DAILY_CHUNKS=6

# ---------- Telegram (interim remote; optional) ----------
TELEGRAM_BOT_TOKEN=
# Your own numeric chat id (send /start to the bot; the brain logs it)
TELEGRAM_CHAT_ID=
DAILY_BRIEF_HOUR=8
# A question to you is tracked quietly; it's surfaced only if you haven't replied after this many minutes
QUESTION_GRACE_MINUTES=20

# ---------- Alerts (quiet by default; see brain/app/alerts.py) ----------
# The Orchestrator hub that reaches the phone app. Empty = Telegram only. On the Linux machine
# deploy/linux/native.env sets it to the hub running next to the brain.
HUB_URL=
# The hub's ORC_TOKEN (from the Orchestrator's .env). A hub on the same machine accepts loopback
# calls without it.
ORC_TOKEN=
# Local time. Inside it only calls ring; everything else waits until it ends. Empty = no quiet hours.
QUIET_HOURS=23:00-07:00
SNOOZE_MINUTES=60
# ntfy: push fallback when the hub does not answer (order: hub -> ntfy -> Telegram). Off while
# NTFY_TOPIC is empty. Install the ntfy app on the phone and subscribe to the same topic. On ntfy.sh
# the topic name is the only secret: make it long and random (openssl rand -hex 16). Alert titles
# and bodies pass through that server.
NTFY_URL=https://ntfy.sh
NTFY_TOPIC=
# Optional access token (a self-hosted server with auth, or a reserved topic on ntfy.sh)
NTFY_TOKEN=
# Opened when you tap the notification, e.g. the hub's web app http://<hub tailscale ip>:4317.
# Done / Snooze / Not important stay in the app and Telegram (the brain is loopback-only).
NTFY_CLICK_URL=

# ---------- Health (see brain/app/health.py; checks every 5 minutes) ----------
# healthchecks.io ping URL (https://hc-ping.com/<uuid>). Pinged every 5 minutes; if pings stop
# (the machine is dead) healthchecks.io emails you. Empty = no dead-man ping.
HEALTHCHECK_URL=
HEALTH_HUB_DOWN_MINUTES=30
HEALTH_MIN_FREE_GB=2
HEALTH_MAX_DB_MB=1024
HEALTH_BACKUP_MAX_HOURS=36

# ---------- Backups (deploy/linux/backup.sh, restic, nightly 03:45) ----------
# Empty = no backups and no timer. Examples: rclone:gdrive:assistant-backup (rclone remote named
# gdrive, see deploy/linux/README.md), s3:https://<account>.r2.cloudflarestorage.com/<bucket>
BACKUP_REPO=
# File holding the restic password (one line, chmod 600). Keep a copy off this machine.
BACKUP_PASSWORD_FILE=
# The Orchestrator checkout whose data/ and secrets are backed up too. Empty = ../Orchestrator or
# ../ai-orchestrator, whichever exists.
ORCHESTRATOR_DIR=
# S3 / R2 only:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# ---------- Watcher (brain/app/watcher.py): what you are about to miss ----------
# Every WATCH_MINUTES: deadlines within 6 h (notification) / 1 h (alarm), promises you made that are
# past due, bills (2 days before, alarm on the day), renewals (7 days before, on the day), health.
WATCH_ENABLED=true
WATCH_MINUTES=5
# "WhatsApp may be logged out" after this many hours without a message (only if it normally flows)
WATCH_WHATSAPP_SILENT_HOURS=12
# An alarm nobody answered becomes a voice call after this many minutes; at most CALLS_PER_DAY calls.
ESCALATE_MINUTES=5
CALLS_PER_DAY=2
# Ask the classifier model "worth interrupting now?" before a watcher alert (8 s; on error the rule stands)
WATCH_JUDGE=true
# Comma-separated WhatsApp jids / email addresses whose unanswered questions ring (alarm), on top of
# family, professors, advisors and managers known to the memory graph. Example: 919800000001@s.whatsapp.net
WATCH_VIP_CHATS=

# ---------- Background work (brain/app/review.py) ----------
# Weekly review (Sunday 18:00) and the monthly noise report (1st, 09:00), both as briefs
REVIEW_ENABLED=true
# Draft (never send) Gmail replies to questions people mail you. Uses the gmail.compose scope
# already granted by app.google_auth.
DRAFTS_ENABLED=false

# ---------- Bridge ----------
# Where the bridge posts messages. Inside docker-compose this is http://brain:8000
BRAIN_URL=http://brain:8000
# Forward voice notes as base64 audio (true/false). Text is always forwarded.
FORWARD_AUDIO=true
# Forward images for the brain to describe: off | dm (direct chats + captioned group images) | all
FORWARD_IMAGES=dm
# Brain-side: transcribe voice notes / describe images with Gemini (same keys). true/false
PERCEIVE_ENABLED=true
# History backfill at link time: off | recent (what WhatsApp sends by default, ~weeks) | full.
# Stored as context only — never triaged into tasks. Changing this needs a re-link (delete
# data/bridge-auth and re-scan the QR) because WhatsApp only sends history when a device links.
HISTORY_SYNC=recent
# Comma-separated JIDs to ignore entirely (e.g. noisy groups). Leave blank for none.
IGNORE_JIDS=
