# ---------- Brain ----------
BRAIN_HOST=0.0.0.0
BRAIN_PORT=8000
# Shared secret between bridge/worker/app and the brain. Generate: openssl rand -hex 24
BRAIN_TOKEN=change-me
# Your name as people write it in chats — the classifier uses it to decide what's addressed to you
OWNER_NAME=Kishaunjith
DATABASE_URL=sqlite:///./data/brain.db
TZ=Asia/Kolkata

# ---------- LLM: cheap classifier (high volume) ----------
# Gemini free tier via its OpenAI-compatible endpoint:
CLASSIFIER_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
CLASSIFIER_API_KEY=
CLASSIFIER_MODEL=gemini-2.5-flash
# Minimum classifier confidence before a task is surfaced for confirmation
CLASSIFIER_MIN_CONFIDENCE=0.6

# ---------- LLM: strong planner (low volume: brief, drafting) ----------
# OpenRouter example. Any OpenAI-compatible endpoint works.
PLANNER_BASE_URL=https://openrouter.ai/api/v1
PLANNER_API_KEY=
PLANNER_MODEL=anthropic/claude-sonnet-4

# ---------- Telegram (interim remote; optional) ----------
TELEGRAM_BOT_TOKEN=
# Your own numeric chat id (send /start to the bot; the brain logs it)
TELEGRAM_CHAT_ID=
DAILY_BRIEF_HOUR=8

# ---------- Bridge ----------
# Where the bridge posts messages. Inside docker-compose this is http://brain:8000
BRAIN_URL=http://brain:8000
# Forward voice notes as base64 audio (true/false). Text is always forwarded.
FORWARD_AUDIO=true
# Comma-separated JIDs to ignore entirely (e.g. noisy groups). Leave blank for none.
IGNORE_JIDS=
